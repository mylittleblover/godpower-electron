{
  "name": "godpower-electron",
  "productName": "上帝的力量",
  "version": "3.0.68",
  "private": true,
  "description": "Offline Electron desktop shell for 上帝的力量",
  "author": "mylittleblover",
  "license": "UNLICENSED",
  "main": "main.cjs",
  "scripts": {
    "sync:html": "node scripts/sync-html.mjs",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "node scripts/smoke.mjs",
    "build:win": "electron-builder --win nsis portable --x64 --publish never",
    "build:win:cross": "electron-builder --win dir zip --x64 --config.win.signAndEditExecutable=false --publish never",
    "build:dir": "electron-builder --dir --publish never",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "prebuild:win": "npm run verify:bundle",
    "prebuild:win:cross": "npm run verify:bundle",
    "test:desktop": "node scripts/desktop-test.mjs",
    "test:windows": "node scripts/windows-smoke.mjs",
    "prepare:drive": "node scripts/prepare-drive-release.mjs"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.8.1",
    "playwright": "1.56.1"
  },
  "build": {
    "appId": "com.mylittleblover.godpower",
    "productName": "上帝的力量",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "desktop/**",
      "!desktop/test-probe.cjs",
      "!desktop/smoke-probe.cjs",
      "preload/**",
      "renderer/**",
      "resources/index.html",
      "resources/BUILD_INFO.json",
      "resources/save-schema.js",
      "package.json",
      "build/icon.ico",
      "build/marx-icon.png",
      "build/classic-icon.png"
    ],
    "asar": true,
    "compression": "normal",
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mylittleblover/godpower-electron.git"
  }
}
